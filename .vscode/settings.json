{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.rulers": [80],
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always"
  },
  "oxc.path.oxlint": "node_modules/.bin/oxlint",
  "oxc.path.oxfmt": "node_modules/.bin/oxfmt",
  "oxc.configPath": ".oxlintrc.json",
  "oxc.fmt.configPath": ".oxfmtrc.json",
  "oxc.lint.run": "onType",
  "oxc.requireConfig": true,
  "oxc.fixKind": "safe_fix",
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never"
    }
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[markdown]": {
    "editor.formatOnSave": false,
    "files.trimTrailingWhitespace": false
  },
  "[yaml]": {
    "editor.formatOnSave": false
  },
  "[shellscript]": {
    "editor.formatOnSave": false
  },
  "[jsonc]": {
    "editor.formatOnSave": false
  },
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 5,
  "editor.linkedEditing": true,
  "editor.renderWhitespace": "trailing",
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.preferences.autoImportFileExcludePatterns": [
    "**/.cloudflare/**",
    "**/*.gen.ts",
    "**/dist/**",
    "**/.wrangler/**"
  ],
  // Low-noise inlay hints (helps read Zod/Hono/TanStack inferred types).
  "js/ts.inlayHints.parameterNames.enabled": "literals",
  "js/ts.inlayHints.functionLikeReturnTypes.enabled": true,
  "js/ts.inlayHints.enumMemberValues.enabled": true,
  "tailwindCSS.experimental.configFile": {
    "apps/front-app/src/index.css": "apps/front-app/src/**"
  },
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },
  "files.associations": {
    "*.css": "tailwindcss",
    ".oxlintrc.json": "jsonc",
    "**/.vite-hooks/*": "shellscript"
  },
  // unpkg is scoped to knip: the bare domain would trust any npm package.
  "json.schemaDownload.trustedDomains": {
    "https://json.schemastore.org/": true,
    "https://react.doctor/schema/": true,
    "https://unpkg.com/knip@": true,
    "https://opencode.ai/": true
  },
  // Exclude Vite-only configs from Vitest discovery; keep vitest.config.* so
  // the explorer finds both .ts (front-*) and .mts (worker-*) packages.
  "vitest.configSearchPatternExclude": "{**/node_modules/**,**/vendor/**,**/.*/**,*.d.ts,**/vite.config.ts,**/dist/**,**/build/**}",
  "vitest.disableWorkspaceWarning": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.eol": "\n",
  "files.readonlyInclude": {
    "**/.cloudflare/**": true,
    "**/routeTree.gen.ts": true,
    "**/route-tree.gen.ts": true,
    "**/*.gen.ts": true,
    "pnpm-lock.yaml": true
  },
  "explorer.sortOrder": "foldersNestsFiles",
  "explorer.compactFolders": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "files.exclude": {
    "**/node_modules": true,
    "**/.turbo": true,
    "**/.cloudflare": true,
    "**/.wrangler": true,
    "**/dist": true,
    "**/build": true,
    "**/.vite": true,
    "**/.tanstack": true,
    "**/.vitest": true,
    "**/coverage": true,
    "**/test-results": true,
    "**/.playwright-cli": true,
    "**/.cache": true,
    "**/.tailwindcss": true,
    "**/*.tsbuildinfo": true,
    "**/.pnpm-store": true,
    "**/.vite-hooks/_": true,
    "**/.claude/worktrees": true,
    "**/.claude/logs": true,
    "**/.claude/agent-memory-local": true,
    "**/CLAUDE.local.md": true,
    "**/.staging.vars": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.turbo/**": true,
    "**/.cloudflare/output/**": true,
    "**/.cloudflare/state/**": true,
    "**/.wrangler/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.vite/**": true,
    "**/.tanstack/**": true,
    "**/.vitest/**": true,
    "**/coverage/**": true,
    "**/test-results/**": true,
    "**/.cache/**": true,
    "**/.pnpm-store/**": true,
    "**/.claude/worktrees/**": true,
    "**/.claude/logs/**": true,
    "**/.claude/memories/**": true
  },
  "search.exclude": {
    "**/.claude/memories": true,
    "pnpm-lock.yaml": true
  },
  "search.useIgnoreFiles": true,
  "search.useGlobalIgnoreFiles": true,
  "search.followSymlinks": false,
  "search.smartCase": true,
  "npm.autoDetect": "off",
  "npm.packageManager": "pnpm",
  "cSpell.enabled": true,
  "cSpell.language": "en",
  "files.autoSave": "onFocusChange"
}
