{
  // Run with: Terminal → Run Task…  (Ctrl/Cmd+Shift+B runs the default build: "ci: full gate")
  // Tests run through the Vitest Test Explorer (extension) until a `turbo run test`
  // pipeline is wired up; there is intentionally no shell "test" task yet.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: full stack",
      "detail": "turbo run dev - worker-api (wrangler :8700) + front-app (vite :5174)",
      "type": "shell",
      "command": "pnpm dev",
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "dev: front-app",
      "detail": "pnpm turbo run dev --filter=front-app - Vite dev server on http://localhost:5174",
      "type": "shell",
      "command": "pnpm turbo run dev --filter=front-app",
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "dev: worker-api",
      "detail": "pnpm turbo run dev --filter=worker-api - wrangler dev on http://localhost:8700",
      "type": "shell",
      "command": "pnpm turbo run dev --filter=worker-api",
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "ci: full gate",
      "detail": "pnpm run ci - boundaries + oxlint + oxfmt + check-types + types:check + build (full-repo pre-PR gate)",
      "type": "shell",
      "command": "pnpm run ci",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "check-types",
      "detail": "pnpm check-types - tsc --noEmit across every workspace (Turborepo transit)",
      "type": "shell",
      "command": "pnpm check-types",
      "group": "build",
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "check: format + lint",
      "detail": "pnpm check - oxlint + oxfmt --check in one pass from the repo root (OXC)",
      "type": "shell",
      "command": "pnpm check",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "types: regenerate wrangler types",
      "detail": "pnpm types - wrangler types (worker-configuration.d.ts) for every Worker",
      "type": "shell",
      "command": "pnpm types",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "build",
      "detail": "pnpm build - turbo run build (front-app: vite build; gated on check-types)",
      "type": "shell",
      "command": "pnpm build",
      "group": "build",
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
