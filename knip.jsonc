{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  "includeEntryExports": true,
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    "apps/front-app": {
      "ignoreDependencies": [
        "@tanstack/react-devtools!",
        "@tanstack/react-query-devtools!",
        "@tanstack/react-router-devtools!",
        "@vitejs/devtools-oxc!",
        "@vitejs/devtools-vite!",
        "@vitejs/devtools-vitest!",
        "tailwindcss!",
      ],
      "project": [
        "**/*.{css,js,cjs,mjs,jsx,ts,cts,mts,tsx}!",
        "!tests/helpers/**!",
      ],
    },
    "apps/worker-api": {
      "ignoreDependencies": ["cloudflare"],
    },
    ".": {
      // Referenced from .github/actions/**/action.yml run steps.
      "entry": [".github/actions/**/*.mjs!"],
      // Vite DevTools Vitest dock CLI; must stay at the root (rules/quality/knip.md).
      "ignoreDependencies": ["@vitest/ui"],
    },
    "packages/vitest-config": {
      "ignoreFiles": ["src/package-root.d.ts"],
    },
  },
  "ignoreWorkspaces": ["packages/vitest-config!"],
}
