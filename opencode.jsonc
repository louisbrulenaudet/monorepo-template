{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true,
    },
  },
  "lsp": true,
  "skills": {
    "paths": [".agents/skills"],
  },
  "permission": {
    "edit": {
      "**/dist/**": "deny",
      "**/build/**": "deny",
      "**/worker-configuration.d.ts": "deny",
      "**/drizzle/migrations/**": "deny",
      "**/pnpm-lock.yaml": "deny",
      "**/.dev.vars*": "deny",
      "**/.prod.vars*": "deny",
      "**/.staging.vars*": "deny",
      "**/.env*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "**/credentials.json": "deny",
      "**/secrets.json": "deny",
    },
    "read": {
      "**/.dev.vars*": "deny",
      "**/.prod.vars*": "deny",
      "**/.staging.vars*": "deny",
      "**/.env*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "**/credentials.json": "deny",
      "**/secrets.json": "deny",
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git push*": "ask",
      "pnpm run ci": "allow",
      "pnpm check-types": "allow",
      "pnpm types": "allow",
      "pnpm types:check": "allow",
      "pnpm run types:check": "allow",
      "pnpm lint:fix": "allow",
      "pnpm lint:agent": "allow",
      "pnpm lint:check": "allow",
      "pnpm format:fix": "allow",
      "pnpm format:check": "allow",
      "pnpm build": "allow",
      "pnpm boundaries": "allow",
      "pnpm run boundaries": "allow",
      "pnpm --filter * run check-types": "allow",
      "pnpm --filter * test": "allow",
      "pnpm --filter * exec tsc --noEmit": "allow",
      "pnpm --filter * run test": "allow",
      "pnpm -r --if-present run test": "allow",
      "pnpm --recursive --if-present run test": "allow",
      "pnpm install": "allow",
      "pnpm install --frozen-lockfile": "allow",
      "oxlint*": "allow",
      "oxfmt*": "allow",
      "turbo run *": "allow",
      "pnpm turbo run *": "allow",
      "wrangler deploy*": "ask",
      "wrangler delete*": "ask",
      "wrangler secret*": "ask",
      "npm publish*": "ask",
      "pnpm publish*": "ask",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "rm -Rf*": "deny",
      "sudo rm*": "deny",
    },
    "external_directory": {
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/.wrangler/**": "deny",
      "~/.wrangler/**": "deny",
    },
  },
}
