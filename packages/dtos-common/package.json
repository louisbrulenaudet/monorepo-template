{
  "name": "@repo/dtos-common",
  "description": "Shared Zod wire contracts for HTTP, RPC, queue, and webhook boundaries.",
  "version": "0.0.0",
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "typescript": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    }
  },
  "keywords": [
    "api",
    "contracts",
    "dto",
    "queue",
    "rpc",
    "shared",
    "webhook",
    "zod"
  ],
  "main": "./src/index.ts",
  "monorepo": {
    "kind": "library",
    "role": "contracts",
    "agentGuide": "AGENTS.md"
  },
  "private": true,
  "scripts": {
    "check-types": "tsc --noEmit",
    "format": "pnpm -w exec oxfmt --check packages/dtos-common",
    "format:fix": "pnpm -w exec oxfmt packages/dtos-common",
    "lint": "pnpm -w exec cross-env SYNCKIT_TIMEOUT=120000 oxlint --no-error-on-unmatched-pattern packages/dtos-common",
    "lint:fix": "pnpm -w exec cross-env SYNCKIT_TIMEOUT=120000 oxlint --no-error-on-unmatched-pattern --fix packages/dtos-common"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./src/index.ts"
}
