{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "tsBuildInfoFile": "${configDir}/../node_modules/.tmp/tsconfig.tests.tsbuildinfo"
  },
  "include": [
    "${configDir}/**/*.ts",
    "${configDir}/**/*.tsx",
    "${configDir}/../src/**/*.ts",
    "${configDir}/../src/**/*.tsx"
  ],
  "exclude": [
    "${configDir}/node_modules",
    "${configDir}/../node_modules",
    "${configDir}/../dist"
  ]
}
