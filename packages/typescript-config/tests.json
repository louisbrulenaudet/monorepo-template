{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "tsBuildInfoFile": "${configDir}/../node_modules/.tmp/tsconfig.tests.tsbuildinfo"
  },
  "include": ["${configDir}/**/*.ts", "${configDir}/../src/**/*.ts"],
  "exclude": ["${configDir}/../node_modules", "${configDir}/../dist"]
}
