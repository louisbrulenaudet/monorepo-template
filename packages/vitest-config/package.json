{
  "name": "@repo/vitest-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Vitest config helpers for Node (front-*) and Cloudflare Workers pool apps.",
  "keywords": [
    "cloudflare",
    "config",
    "shared-config",
    "vitest",
    "workers"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./workers": {
      "types": "./src/workers.ts",
      "default": "./src/workers.ts"
    }
  },
  "scripts": {
    "format": "pnpm -w exec oxfmt --check packages/vitest-config",
    "format:fix": "pnpm -w exec oxfmt packages/vitest-config",
    "lint": "pnpm -w exec cross-env SYNCKIT_TIMEOUT=120000 oxlint --no-error-on-unmatched-pattern packages/vitest-config",
    "lint:fix": "pnpm -w exec cross-env SYNCKIT_TIMEOUT=120000 oxlint --no-error-on-unmatched-pattern --fix packages/vitest-config"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "vitest": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/vitest-pool-workers": {
      "optional": true
    }
  },
  "monorepo": {
    "kind": "config",
    "role": "vitest-config",
    "agentGuide": "AGENTS.md"
  }
}
