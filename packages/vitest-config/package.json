{
  "name": "@repo/vitest-config",
  "description": "Shared Vitest config helpers for Node (front-*) and Cloudflare Workers plugin apps.",
  "version": "0.0.0",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./workers": {
      "types": "./src/workers.ts",
      "default": "./src/workers.ts"
    }
  },
  "keywords": [
    "cloudflare",
    "config",
    "shared-config",
    "vitest",
    "workers"
  ],
  "license": "MIT",
  "monorepo": {
    "kind": "config",
    "role": "vitest-config",
    "agentGuide": "AGENTS.md"
  },
  "peerDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/vitest-plugin": {
      "optional": true
    }
  },
  "private": true,
  "scripts": {
    "format:check": "pnpm -w exec oxfmt --check packages/vitest-config",
    "format:fix": "pnpm -w exec oxfmt packages/vitest-config",
    "lint:check": "SYNCKIT_TIMEOUT=120000 pnpm -w exec oxlint --no-error-on-unmatched-pattern packages/vitest-config",
    "lint:fix": "SYNCKIT_TIMEOUT=120000 pnpm -w exec oxlint --no-error-on-unmatched-pattern --fix packages/vitest-config"
  },
  "sideEffects": false,
  "type": "module"
}
