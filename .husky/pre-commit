set -e
# Apply fixes to staged snapshots only, preserving unrelated working-tree edits.
pnpm exec git-format-staged --formatter 'pnpm exec oxfmt {{path}}' '*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}'
pnpm exec git-format-staged --formatter 'pnpm exec cross-env SYNCKIT_TIMEOUT=120000 oxlint --no-error-on-unmatched-pattern --fix {{path}}' '*.{ts,tsx,js,jsx,mjs,cjs}'
