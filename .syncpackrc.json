{
  "$schema": "./node_modules/syncpack/schema.json",
  "strict": true,
  "dependencyGroups": [
    {
      "aliasName": "sentry-sdk",
      "dependencies": [
        "@sentry/cloudflare",
        "@sentry/hono",
        "@sentry/react",
        "@sentry/vite-plugin"
      ]
    }
  ],
  "versionGroups": [
    {
      "label": "sentry sdk in lockstep",
      "dependencies": ["sentry-sdk"],
      "dependencyTypes": ["pnpmCatalog"],
      "policy": "sameRange"
    },
    {
      "label": "internal workspace links",
      "dependencies": ["@repo/**"],
      "dependencyTypes": ["prod", "dev"],
      "pinVersion": "workspace:*"
    },
    {
      "label": "peer compatibility ranges",
      "dependencyTypes": ["peer"],
      "isIgnored": true
    },
    {
      "label": "third-party via pnpm catalog",
      "dependencies": ["**"],
      "dependencyTypes": ["prod", "dev"],
      "policy": "catalog"
    }
  ]
}
