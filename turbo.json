{
  "$schema": "./node_modules/turbo/schema.json",
  "agentGuidance": false,
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    // Off on purpose - see core/turborepo (drops dependents for transit tasks).
    "filterUsingTasks": false,
    "watchUsingTaskInputs": true,
    "strictTaskEntrypointSelection": true,
    "longerSignatureKey": true,
    "globalConfiguration": true,
    "errorsOnlyShowHash": true,
    "githubActionsRemoteBaseRefFallback": true
  },
  "global": {
    "ui": "tui",
    "envMode": "strict",
    "cacheMaxAge": "7d",
    "cacheMaxSize": "10GB",
    "remoteCache": {
      "enabled": true,
      "signature": true
    },
    // Prepended to each task's inputs; never add OXC configs here (core/turborepo).
    "inputs": ["pnpm-workspace.yaml"],
    "passThroughEnv": [
      "CI",
      "NODE_ENV",
      "NODE_COMPILE_CACHE",
      "NODE_DISABLE_COMPILE_CACHE",
      // Else os.tmpdir() is /tmp, where Miniflare cannot mkdir in the Claude Code sandbox.
      "TMPDIR",
      // Without the log/registry paths, sandboxed wrangler hits EPERM in ~/.wrangler.
      "WRANGLER_SEND_METRICS",
      "WRANGLER_LOG_PATH",
      "WRANGLER_REGISTRY_PATH",
      "CLOUDFLARE_REGISTRY_PATH",
      "CF_SEND_TELEMETRY",
      "DO_NOT_TRACK",
      "SKIP_ENV_FILES"
    ]
  },
  "boundaries": {
    "tags": {
      "app": {
        "dependencies": {
          "allow": ["contracts", "contracts-base", "config", "framework", "lib"]
        },
        "dependents": {
          "deny": [
            "app",
            "contracts",
            "contracts-base",
            "config",
            "framework",
            "lib"
          ]
        }
      },
      "framework": {
        "dependencies": {
          "allow": ["contracts-base", "config", "lib"]
        },
        "dependents": {
          "deny": ["contracts", "contracts-base", "config", "lib"]
        }
      },
      "contracts": {
        "dependencies": {
          "allow": ["contracts-base", "config"]
        }
      },
      "contracts-base": {
        "dependencies": {
          "allow": ["config"]
        }
      },
      "lib": {
        "dependencies": {
          "allow": ["config"]
        }
      },
      "config": {
        "dependencies": {
          "allow": []
        }
      }
    }
  },
  "tasks": {
    "//#lint:check": {
      "description": "Whole-repo oxlint pass, human format.",
      "cache": false
    },
    "//#lint:agent": {
      "description": "Same oxlint pass with --format=agent (machine-readable).",
      "cache": false
    },
    "//#format:check": {
      "description": "Whole-repo oxfmt --check.",
      "cache": false
    },
    "//#deps:check": {
      "description": "syncpack lint: catalog: for third-party deps, workspace:* for internal.",
      "inputs": [
        "package.json",
        "apps/*/package.json",
        "packages/*/package.json",
        "pnpm-workspace.yaml",
        ".syncpackrc.json"
      ]
    },
    "//#deps:format:check": {
      "description": "syncpack format --check: package.json field ordering.",
      "inputs": [
        "package.json",
        "apps/*/package.json",
        "packages/*/package.json",
        "pnpm-workspace.yaml",
        ".syncpackrc.json"
      ]
    },
    "//#hooks:test": {
      "description": "sh -n plus the regression table for the agent guard hooks.",
      "cache": false
    },
    "//#release:check": {
      "description": "Changeset gate: coverage since origin/main, app-only names, title shape, gated majors.",
      "cache": false,
      "passThroughEnv": ["CHANGESET_ALLOW_MAJOR"]
    },
    "//#spell:check": {
      "description": "Whole-repo cspell lint.",
      "cache": false
    },
    "transit": {
      "description": "No-op graph edge that propagates dependency source changes.",
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!AGENTS.md", "!CLAUDE.md"]
    },
    "check-types": {
      "description": "Type-check with tsc --noEmit.",
      "dependsOn": ["transit", "types"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!AGENTS.md", "!CLAUDE.md"],
      "outputs": ["node_modules/.tmp/*.tsbuildinfo"]
    },
    "types": {
      "description": "Generate .cloudflare/types/index.d.ts from cloudflare.config.ts (cf workers types).",
      "inputs": ["cloudflare.config.ts"],
      "outputs": [".cloudflare/types/**"]
    },
    "build": {
      "description": "Build the Build Output into .cloudflare/output/ (cf build).",
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "!CLAUDE.md",
        "!tests/**",
        "!vitest.config.*",
        "!vitest.setup.*"
      ],
      "outputs": [".cloudflare/output/**"],
      "env": ["NODE_ENV"]
    },
    "test": {
      "description": "Run Vitest (Workers pool for worker-* apps; Node for front-*).",
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!AGENTS.md", "!CLAUDE.md"],
      "outputs": [],
      "passThroughEnv": [
        "AI_AGENT",
        "GITHUB_ACTIONS",
        "GITHUB_STEP_SUMMARY",
        "GITHUB_SERVER_URL",
        "GITHUB_REPOSITORY",
        "GITHUB_SHA",
        "GITHUB_WORKSPACE"
      ]
    },
    "test:watch": {
      "description": "Vitest watch mode. Humans only - agents must use the test task.",
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "AI_AGENT",
        "GITHUB_ACTIONS",
        "GITHUB_STEP_SUMMARY",
        "GITHUB_SERVER_URL",
        "GITHUB_REPOSITORY",
        "GITHUB_SHA",
        "GITHUB_WORKSPACE"
      ]
    },
    "dev": {
      "description": "Run the local dev server.",
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["VITE_API_BASE_URL"]
    },
    "preview": {
      "description": "Serve the production build locally.",
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["VITE_API_BASE_URL", "NODE_ENV"]
    },
    "deploy": {
      "description": "cf deploy --prebuilt --mode production: upload + 100% at once (local/bootstrap).",
      "dependsOn": ["build", "check-types"],
      "cache": false,
      "passThroughEnv": [
        "CI",
        "NODE_ENV",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID"
      ]
    },
    "deploy:check": {
      "description": "cf deploy --prebuilt --mode production --dry-run: validate the Build Output, no credentials.",
      "dependsOn": ["build"],
      "inputs": ["cloudflare.config.ts"],
      "outputs": []
    },
    "upload": {
      "description": "cf workers versions create --prebuilt --mode production (no traffic change).",
      "dependsOn": ["build", "check-types"],
      "cache": false,
      "passThroughEnv": [
        "CI",
        "NODE_ENV",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID",
        "WRANGLER_OUTPUT_FILE_PATH"
      ]
    }
  }
}
