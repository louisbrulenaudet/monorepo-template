{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "hooks/git/guard-secret-commit.sh",
        "timeout": 10,
        "failClosed": true
      },
      {
        "command": "hooks/git/guard-destructive-git.sh",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": "hooks/quality/check-changed.sh",
        "timeout": 150
      }
    ],
    "sessionStart": [
      {
        "command": "hooks/logging/session-start.sh",
        "timeout": 10
      },
      {
        "command": "hooks/session/session-context.sh",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "hooks/quality/stop-gate.sh",
        "timeout": 180,
        "loop_limit": 1
      }
    ]
  }
}
