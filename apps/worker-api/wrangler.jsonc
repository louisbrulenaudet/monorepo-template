{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "worker-api",
  "main": "src/index.ts",
  // >= 2026-08-04 enables nodejs_compat by default; do not add the flag.
  "compatibility_date": "2026-08-11",
  "send_metrics": false,
  "upload_source_maps": true,
  "minify": true,
  "preview_urls": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  // "placement": { "mode": "smart" }, // only when calling a centralized backend (DB/Hyperdrive); adds latency for a pure edge gateway
  "cache": {
    "enabled": true,
  },
  "exports": {
    "default": {
      "type": "worker",
      "cache": {
        "enabled": false,
      },
    },
  },
  "dev": {
    "port": 8700,
    "inspector_port": 0,
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  // Uncomment when adding secrets - wrangler types + deploy validate these names. Local values go in
  // apps/worker-api/.env, never .dev.vars: an unreadable .dev.vars aborts the Vitest pool, an
  // unreadable .env is skipped (so sandboxed agents and CI run on the fake test bindings instead).
  // "secrets": {
  //   "required": ["EXAMPLE_SECRET"],
  // },
  "vars": {
    "ENVIRONMENT": "dev", // AppEnvironment.DEV
    // Comma-separated browser origins. Empty/unset is permissive (*) when ENVIRONMENT is AppEnvironment.DEV only.
    "CORS_ORIGINS": "http://localhost:5174",
  },
  "env": {
    "staging": {
      "preview_urls": false,
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "vars": {
        "ENVIRONMENT": "staging",
        // Wire value = AppEnvironment.STAGING (@repo/enums-common).
        // Required before go-live. Empty → /api/* returns 503 (fail closed).
        // Example: "https://front-app-staging.example.com"
        "CORS_ORIGINS": "",
      },
      "observability": {
        "enabled": true,
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.01,
        },
      },
    },
    "production": {
      // Serves Worker Previews on workers.dev - and production Version URLs with it.
      // Enable Cloudflare Access on Preview URLs before arming PREVIEWS_ENABLED.
      "preview_urls": true,
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "vars": {
        "ENVIRONMENT": "production",
        // Wire value = AppEnvironment.PRODUCTION (@repo/enums-common).
        // Required before go-live. Empty → /api/* returns 503 (fail closed).
        // Example: "https://app.example.com"
        "CORS_ORIGINS": "",
      },
      "observability": {
        "enabled": true,
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.01,
        },
      },
      // `wrangler preview --env production`. Vars and bindings are not inherited -
      // restate each one the code reads; observability here raises sampling to 100%.
      "previews": {
        "version_metadata": {
          "binding": "CF_VERSION_METADATA",
        },
        "vars": {
          "ENVIRONMENT": "preview",
          // Wire value = AppEnvironment.PREVIEW. Wildcards are honored here only.
          // Empty → /api/* returns 503 (fail closed).
          // Example: "https://*-front-app-production.<subdomain>.workers.dev"
          "CORS_ORIGINS": "",
        },
        "observability": {
          "enabled": true,
          "logs": {
            "enabled": true,
            "invocation_logs": true,
            "persist": true,
          },
          "traces": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true,
          },
        },
      },
    },
  },
}
