{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "worker-api",
  "main": "src/index.ts",
  // >= 2026-08-04 enables nodejs_compat by default; do not add the flag.
  "compatibility_date": "2026-08-11",
  "send_metrics": false,
  "upload_source_maps": true,
  "minify": true,
  "preview_urls": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "cache": {
    "enabled": true,
  },
  "exports": {
    "default": {
      "type": "worker",
      "cache": {
        "enabled": false,
      },
    },
  },
  "dev": {
    "port": 8700,
    "inspector_port": 0,
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "secrets": {
    "required": ["SENTRY_DSN"],
  },
  "vars": {
    "ENVIRONMENT": "dev", // AppEnvironment.DEV
    // Comma-separated browser origins. Empty/unset is permissive (*) when ENVIRONMENT is AppEnvironment.DEV only.
    "CORS_ORIGINS": "http://localhost:5174",
  },
  "env": {
    "staging": {
      "preview_urls": false,
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "secrets": {
        "required": ["SENTRY_DSN"],
      },
      "vars": {
        "ENVIRONMENT": "staging",
        // Empty → /api/* returns 503 (fail closed).
        "CORS_ORIGINS": "",
      },
      "observability": {
        "enabled": true,
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.01,
        },
      },
    },
    "production": {
      "preview_urls": true,
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "secrets": {
        "required": ["SENTRY_DSN"],
      },
      "vars": {
        "ENVIRONMENT": "production",
        // Empty → /api/* returns 503 (fail closed).
        "CORS_ORIGINS": "",
      },
      "observability": {
        "enabled": true,
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.01,
        },
      },
      // Vars and bindings are not inherited - restate each one the code reads.
      "previews": {
        "version_metadata": {
          "binding": "CF_VERSION_METADATA",
        },
        "vars": {
          "ENVIRONMENT": "preview",
          // Wildcards honored here only; empty → /api/* returns 503.
          "CORS_ORIGINS": "",
        },
        "observability": {
          "enabled": true,
          "logs": {
            "enabled": true,
            "invocation_logs": true,
            "persist": true,
          },
          "traces": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true,
          },
        },
      },
    },
  },
}
