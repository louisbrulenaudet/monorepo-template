{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "worker-api",
  "main": "src/index.ts",
  // >= 2026-08-04 enables nodejs_compat by default; do not add the flag.
  "compatibility_date": "2026-08-11",
  "send_metrics": false,
  "upload_source_maps": true,
  "minify": true,
  "preview_urls": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  // "placement": { "mode": "smart" }, // only when calling a centralized backend (DB/Hyperdrive); adds latency for a pure edge gateway
  "cache": {
    "enabled": true,
  },
  "exports": {
    "default": {
      "type": "worker",
      "cache": {
        "enabled": false,
      },
    },
  },
  "dev": {
    "port": 8700,
    "inspector_port": 0,
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
    },
  },
  // Uncomment when adding secrets - wrangler types + deploy validate these names (no .dev.vars needed in CI):
  // "secrets": {
  //   "required": ["EXAMPLE_SECRET"],
  // },
  "vars": {
    "ENVIRONMENT": "dev", // AppEnvironment.DEV
    // Comma-separated browser origins. Empty/unset is permissive (*) when ENVIRONMENT is AppEnvironment.DEV only.
    "CORS_ORIGINS": "http://localhost:5174",
  },
  "env": {
    "staging": {
      "preview_urls": false,
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "vars": {
        "ENVIRONMENT": "staging",
        // Wire value = AppEnvironment.STAGING (@repo/enums-common).
        // Required before go-live. Empty → /api/* returns 503 (fail closed).
        // Example: "https://front-app-staging.example.com"
        "CORS_ORIGINS": "",
      },
      "observability": {
        "enabled": true,
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.01,
        },
      },
    },
    "production": {
      "preview_urls": false,
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "vars": {
        "ENVIRONMENT": "production",
        // Wire value = AppEnvironment.PRODUCTION (@repo/enums-common).
        // Required before go-live. Empty → /api/* returns 503 (fail closed).
        // Example: "https://app.example.com"
        "CORS_ORIGINS": "",
      },
      "observability": {
        "enabled": true,
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.01,
        },
      },
    },
  },
}
