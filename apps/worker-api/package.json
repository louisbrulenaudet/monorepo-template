{
  "name": "worker-api",
  "description": "Public Hono HTTP gateway on Cloudflare Workers; validates requests with shared Zod contracts.",
  "version": "0.1.0",
  "dependencies": {
    "@hono/zod-validator": "catalog:",
    "@repo/correlation-id": "workspace:*",
    "@repo/dtos-common": "workspace:*",
    "@repo/enums-common": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "keywords": [
    "api",
    "cloudflare-workers",
    "hono",
    "http-gateway",
    "worker",
    "zod"
  ],
  "main": "src/index.ts",
  "monorepo": {
    "kind": "app",
    "role": "http-gateway",
    "prefix": "worker-",
    "devPort": 8700,
    "deployOrder": 1,
    "healthPath": "/api/v1/health",
    "agentGuide": "AGENTS.md"
  },
  "private": true,
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist --env production",
    "check-types": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "deploy": "wrangler deploy --env production",
    "dev": "wrangler dev",
    "format": "pnpm -w exec oxfmt --check apps/worker-api",
    "format:fix": "pnpm -w exec oxfmt apps/worker-api",
    "lint": "pnpm -w exec cross-env SYNCKIT_TIMEOUT=120000 oxlint --no-error-on-unmatched-pattern apps/worker-api",
    "lint:fix": "pnpm -w exec cross-env SYNCKIT_TIMEOUT=120000 oxlint --no-error-on-unmatched-pattern --fix apps/worker-api",
    "promote": "wrangler versions deploy --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types -c ./wrangler.jsonc",
    "types:check": "wrangler types -c ./wrangler.jsonc --check",
    "upload": "wrangler versions upload --env production"
  }
}
