{
  "name": "front-app",
  "version": "0.0.0",
  "private": true,
  "description": "React SPA (Vite + TanStack Router/Query) deployed on Cloudflare; talks to worker-api over HTTP only.",
  "keywords": [
    "cloudflare",
    "frontend",
    "react",
    "spa",
    "tailwindcss",
    "tanstack-query",
    "tanstack-router",
    "vite"
  ],
  "type": "module",
  "imports": {
    "#/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "analyze": "ANALYZE=true vite build",
    "build": "vite build",
    "check-types": "pnpm run routes:check && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "deploy": "wrangler deploy --env production",
    "dev": "vite",
    "format": "pnpm -w exec oxfmt --check apps/front-app",
    "format:fix": "pnpm -w exec oxfmt apps/front-app",
    "lint": "pnpm -w exec cross-env SYNCKIT_TIMEOUT=120000 oxlint --no-error-on-unmatched-pattern apps/front-app",
    "lint:fix": "pnpm -w exec cross-env SYNCKIT_TIMEOUT=120000 oxlint --no-error-on-unmatched-pattern --fix apps/front-app",
    "preview": "vite preview",
    "routes:check": "tsr generate && git diff --exit-code -- src/routeTree.gen.ts",
    "routes:generate": "tsr generate",
    "types": "wrangler types -c ./wrangler.jsonc",
    "types:check": "wrangler types -c ./wrangler.jsonc --check"
  },
  "dependencies": {
    "@repo/dtos-common": "workspace:*",
    "@repo/enums-common": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@repo/typescript-config": "workspace:*",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/devtools-vite": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/router-cli": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  },
  "monorepo": {
    "kind": "app",
    "role": "frontend",
    "prefix": "front-",
    "devPort": 5174,
    "agentGuide": "AGENTS.md"
  }
}
