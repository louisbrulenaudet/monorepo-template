{
  "name": "front-app",
  "description": "React SPA (Vite + TanStack Router/Query) deployed on Cloudflare; talks to worker-api over HTTP only.",
  "version": "0.1.0",
  "dependencies": {
    "@repo/correlation-id": "workspace:*",
    "@repo/dtos-common": "workspace:*",
    "@repo/enums-common": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/devtools-vite": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/router-cli": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/devtools": "catalog:",
    "@vitejs/devtools-oxc": "catalog:",
    "@vitejs/devtools-rolldown": "catalog:",
    "@vitejs/devtools-vite": "catalog:",
    "@vitejs/devtools-vitest": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "happy-dom": "catalog:",
    "oxc-transform-react": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "zod": "catalog:"
  },
  "imports": {
    "#/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "keywords": [
    "cloudflare",
    "frontend",
    "react",
    "spa",
    "tailwindcss",
    "tanstack-query",
    "tanstack-router",
    "vite"
  ],
  "monorepo": {
    "kind": "app",
    "role": "frontend",
    "prefix": "front-",
    "devPort": 5174,
    "deployOrder": 2,
    "healthPath": "/",
    "agentGuide": "AGENTS.md"
  },
  "private": true,
  "scripts": {
    "analyze": "ANALYZE=true vite build",
    "build": "vite build",
    "check-types": "pnpm run routes:check && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tests/tsconfig.json",
    "deploy": "wrangler deploy --env production",
    "dev": "vite",
    "format": "pnpm -w exec oxfmt --check apps/front-app",
    "format:fix": "pnpm -w exec oxfmt apps/front-app",
    "lint": "pnpm -w exec cross-env SYNCKIT_TIMEOUT=120000 oxlint --no-error-on-unmatched-pattern apps/front-app",
    "lint:fix": "pnpm -w exec cross-env SYNCKIT_TIMEOUT=120000 oxlint --no-error-on-unmatched-pattern --fix apps/front-app",
    "preview": "vite preview",
    "promote": "wrangler versions deploy --env production",
    "routes:check": "tsr generate && git diff --exit-code -- src/routeTree.gen.ts",
    "routes:generate": "tsr generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types -c ./wrangler.jsonc",
    "types:check": "wrangler types -c ./wrangler.jsonc --check",
    "upload": "wrangler versions upload --env production"
  },
  "type": "module"
}
