{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "front-app",
  // >= 2026-08-04 enables nodejs_compat by default; do not add the flag.
  "compatibility_date": "2026-09-23",
  "send_metrics": false,
  // Keep, even empty: stops `wrangler types` inferring Env from .env* (workers-config).
  "secrets": {
    "required": [],
  },
  // workers.dev deploys for template; set workers_dev: false when using custom domains only.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "vars": {
    "ENVIRONMENT": "dev",
  },
  "env": {
    "staging": {
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "staging",
      },
      "observability": {
        "enabled": true,
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.01,
        },
      },
    },
    "production": {
      "preview_urls": true,
      "vars": {
        "ENVIRONMENT": "production",
      },
      "observability": {
        "enabled": true,
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.01,
        },
      },
      // Vars and bindings are not inherited - restate each one the code reads.
      "previews": {
        "vars": {
          "ENVIRONMENT": "preview",
        },
      },
    },
  },
}
