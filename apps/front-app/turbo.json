{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tags": ["app"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_EXTENDS$",
        ".env",
        ".env.*",
        "!.env.example",
        "!.env.*.example"
      ],
      "env": [
        "$TURBO_EXTENDS$",
        "VITE_API_BASE_URL",
        "VITE_APP_ENVIRONMENT",
        "VITE_SENTRY_DSN",
        "CLOUDFLARE_ENV"
      ]
    },
    "dev": {
      "description": "Vite dev server, started together with worker-api#dev.",
      "with": ["worker-api#dev"],
      "interruptible": true
    },
    "deploy": {
      "description": "wrangler deploy of ./dist as Cloudflare assets at 100%.",
      "dependsOn": ["$TURBO_EXTENDS$", "build"]
    },
    "upload": {
      "description": "wrangler versions upload of ./dist (no traffic change).",
      "dependsOn": ["$TURBO_EXTENDS$", "build"]
    }
  }
}
