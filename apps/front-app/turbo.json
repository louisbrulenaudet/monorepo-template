{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tags": ["app"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_EXTENDS$",
        ".env",
        ".env.*",
        "!.env.example",
        "!.env.*.example"
      ],
      "env": [
        "$TURBO_EXTENDS$",
        "VITE_API_BASE_URL",
        "VITE_APP_ENVIRONMENT",
        "VITE_SENTRY_DSN"
      ]
    },
    "dev": {
      "description": "cf dev (Vite) on :5174, started together with worker-api#dev.",
      "with": ["worker-api#dev"],
      "interruptible": true
    }
  }
}
