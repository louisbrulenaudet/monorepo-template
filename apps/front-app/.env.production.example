# Required for production builds (vite build / deploy).
# Copy to `.env.production` and set your deployed worker-api URL.
# Do not leave placeholder hosts (*.example.com / *.your-domain.com).
VITE_API_BASE_URL=https://worker-api.example.com

# Optional. Sentry DSN of the front-app React project (public, inlined into the
# bundle); the build also adds its ingest origin to the CSP connect-src.
# Empty disables Sentry.
VITE_SENTRY_DSN=

# Optional. Sentry environment tag (AppEnvironment value); unset means
# `production`. Set `staging` for a staging build so it matches worker-api.
VITE_APP_ENVIRONMENT=
