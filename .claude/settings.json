{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "effortLevel": "high",
  "subagentPromptCacheTtl": "1h",
  "statusLine": {
    "type": "command",
    "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/status-line.sh\""
  },
  "permissions": {
    "allow": [
      "Bash(pnpm run ci)",
      "Bash(pnpm check-types)",
      "Bash(pnpm types)",
      "Bash(pnpm types:check)",
      "Bash(pnpm run types:check)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm lint:agent)",
      "Bash(pnpm lint:check)",
      "Bash(pnpm react-doctor:*)",
      "Bash(pnpm run react-doctor:*)",
      "Bash(pnpm format:fix)",
      "Bash(pnpm format:check)",
      "Bash(pnpm build)",
      "Bash(pnpm boundaries)",
      "Bash(pnpm release:check)",
      "Bash(pnpm run release:check)",
      "Bash(pnpm release:status)",
      "Bash(pnpm run release:status)",
      "Bash(pnpm changeset --patch:*)",
      "Bash(pnpm changeset --minor:*)",
      "Bash(pnpm changeset --empty:*)",
      "Bash(pnpm run boundaries)",
      "Bash(pnpm --filter=front-app exec vitest run:*)",
      "Bash(pnpm --filter=worker-api exec vitest run:*)",
      "Bash(pnpm --filter=@repo/correlation-id exec vitest run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(oxlint:*)",
      "Bash(oxfmt:*)",
      "Bash(turbo run:*)",
      "Bash(pnpm turbo run:*)",
      "Bash(pnpm -r --if-present run test)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm exec playwright-cli *)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:oxc.rs)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:*.githubusercontent.com)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:hono.dev)",
      "WebFetch(domain:cursor.com)",
      "WebFetch(domain:docs.cursor.com)",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:turborepo.dev)",
      "WebFetch(domain:tanstack.com)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:orm.drizzle.team)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:vite.dev)",
      "WebFetch(domain:pnpm.io)",
      "WebFetch(domain:docs.sentry.io)",
      "mcp__cloudflare-docs__*",
      "mcp__context7__*"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -r -f:*)",
      "Bash(rm -f -r:*)",
      "Bash(wrangler preview:*)",
      "Bash(pnpm preview:deploy*)",
      "Bash(pnpm preview:delete*)",
      "Bash(pnpm run preview:*)",
      "Bash(bash .github/actions/previews/*)",
      "Bash(sudo rm:*)",
      "Bash(pnpm changeset version:*)",
      "Bash(pnpm changeset pre:*)",
      "Bash(pnpm changeset git-tag:*)",
      "Bash(pnpm changeset publish:*)",
      "Bash(pnpm exec changeset version:*)",
      "Bash(pnpm exec changeset pre:*)",
      "Bash(pnpm exec changeset git-tag:*)",
      "Bash(pnpm exec changeset publish:*)",
      "Edit(**/drizzle/migrations/**)",
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.local)",
      "Read(**/.dev.vars.staging)",
      "Read(**/.dev.vars.production)",
      "Read(**/.prod.vars)",
      "Read(**/.prod.vars.*)",
      "Read(**/.staging.vars)",
      "Read(**/.staging.vars.*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/credentials.json)",
      "Read(**/secrets.json)",
      "Edit(**/.dev.vars)",
      "Edit(**/.dev.vars.local)",
      "Edit(**/.dev.vars.staging)",
      "Edit(**/.dev.vars.production)",
      "Edit(**/.prod.vars)",
      "Edit(**/.prod.vars.*)",
      "Edit(**/.staging.vars)",
      "Edit(**/.staging.vars.*)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Edit(**/.env.production)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/id_rsa)",
      "Edit(**/id_ed25519)",
      "Edit(**/credentials.json)",
      "Edit(**/secrets.json)",
      "Agent(statusline-setup)"
    ],
    "ask": [
      "Edit(/hooks/**)",
      "Edit(/.claude/status-line.sh)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git checkout --:*)",
      "Bash(git branch -D:*)",
      "Bash(git tag -d:*)",
      "Bash(git filter-branch:*)",
      "Bash(pnpm deploy:*)",
      "Bash(pnpm run deploy:*)",
      "Bash(pnpm turbo run deploy:*)",
      "Bash(wrangler deploy:*)",
      "Bash(wrangler delete:*)",
      "Bash(wrangler secret:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(pnpm changeset --major:*)"
    ],
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/git/guard-secret-commit.sh"
            ],
            "timeout": 10,
            "statusMessage": "Checking git command for secret paths"
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/git/guard-destructive-git.sh"
            ],
            "timeout": 10,
            "statusMessage": "Checking git command for destructive operations"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/security/guard-secret-content.sh"
            ],
            "timeout": 10,
            "statusMessage": "Scanning content for credentials"
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/security/guard-generated-files.sh"
            ],
            "timeout": 10,
            "statusMessage": "Checking for generated files"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/quality/check-changed.sh"
            ],
            "timeout": 150,
            "statusMessage": "Formatting and linting the edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/quality/stop-gate.sh"
            ],
            "timeout": 180,
            "statusMessage": "Running the fast gate on the diff"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/session/session-context.sh"
            ],
            "timeout": 10,
            "statusMessage": "Checking the checkout"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/logging/instructions-loaded.sh"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "monorepo-local": {
      "source": {
        "source": "directory",
        "path": "./.claude/plugins/monorepo-local"
      }
    }
  },
  "enabledPlugins": {
    "ts-native-lsp@monorepo-local": true,
    "typescript-lsp@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "gh *",
      "pnpm exec playwright-cli *"
    ],
    "network": {
      "allowedDomains": [
        "raw.githubusercontent.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "registry.npmjs.org",
        "vercel.com",
        "api.vercel.com",
        "turborepo.dev"
      ],
      "allowLocalBinding": true
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.config/.wrangler",
          "mode": "deny"
        },
        {
          "path": "~/.wrangler/config",
          "mode": "deny"
        },
        {
          "path": "~/Library/Preferences/.wrangler",
          "mode": "deny"
        }
      ]
    },
    "enableWeakerNetworkIsolation": true,
    "filesystem": {
      "allowRead": [
        "**/apps/front-app/.env*",
        "./apps/front-app/.env.production"
      ],
      "allowWrite": [
        "~/Library/pnpm/package-manager-store"
      ],
      "denyWrite": [
        "./hooks",
        "./.claude/status-line.sh"
      ]
    }
  },
  "autoMemoryEnabled": true,
  "enabledMcpjsonServers": [
    "cloudflare-docs",
    "context7"
  ],
  "enableAllProjectMcpServers": false,
  "worktree": {
    "sparsePaths": [
      ".agents",
      ".changeset",
      ".claude",
      ".cspell",
      ".cursor",
      ".github",
      ".playwright",
      ".vite-hooks",
      ".vscode",
      ".cursorignore",
      ".cursorindexingignore",
      ".gitignore",
      ".mcp.json",
      ".nvmrc",
      ".oxfmtrc.json",
      ".oxlintrc.json",
      ".syncpackrc.json",
      ".worktreeinclude",
      "AGENTS.md",
      "CLAUDE.md",
      "LICENSE",
      "README.md",
      "hooks",
      "apps",
      "packages",
      "cspell.json",
      "doctor.config.jsonc",
      "knip.jsonc",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "skills-lock.json",
      "turbo.json",
      "vite.config.ts"
    ],
    "baseRef": "fresh"
  },
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "20",
    "TURBO_TELEMETRY_DISABLED": "1",
    "TURBO_UI": "false",
    "WRANGLER_SEND_METRICS": "false",
    "REACT_DOCTOR_NO_TELEMETRY": "1",
    "WRANGLER_LOG_PATH": "/tmp/claude/wrangler-logs",
    "WRANGLER_REGISTRY_PATH": "/tmp/claude/wrangler-registry",
    "VP_GIT_HOOKS": "0",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "core.fsmonitor",
    "GIT_CONFIG_VALUE_0": "false",
    "NODE_USE_ENV_PROXY": "1",
    "SKIP_ENV_FILES": "1",
    "CLOUDFLARE_REGISTRY_PATH": "/tmp/claude/wrangler-registry"
  }
}
