{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "effortLevel": "high",
  "subagentPromptCacheTtl": "1h",
  "statusLine": {
    "type": "command",
    "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/status-line.sh\""
  },
  "permissions": {
    "allow": [
      "Bash(pnpm run ci)",
      "Bash(pnpm check-types)",
      "Bash(pnpm types)",
      "Bash(pnpm types:check)",
      "Bash(pnpm run types:check)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm lint:agent)",
      "Bash(pnpm lint:check)",
      "Bash(pnpm react-doctor:*)",
      "Bash(pnpm run react-doctor:*)",
      "Bash(pnpm format:fix)",
      "Bash(pnpm format:check)",
      "Bash(pnpm build)",
      "Bash(pnpm boundaries)",
      "Bash(pnpm run boundaries)",
      "Bash(pnpm --filter=front-app exec vitest run:*)",
      "Bash(pnpm --filter=worker-api exec vitest run:*)",
      "Bash(pnpm --filter=@repo/correlation-id exec vitest run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(oxlint:*)",
      "Bash(oxfmt:*)",
      "Bash(turbo run:*)",
      "Bash(pnpm turbo run:*)",
      "Bash(pnpm -r --if-present run test)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:oxc.rs)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:*.githubusercontent.com)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:hono.dev)",
      "WebFetch(domain:cursor.com)",
      "WebFetch(domain:docs.cursor.com)",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:turbo.build)",
      "WebFetch(domain:tanstack.com)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:orm.drizzle.team)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:vite.dev)",
      "WebFetch(domain:pnpm.io)",
      "mcp__cloudflare-docs__*",
      "mcp__context7__*"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -r -f:*)",
      "Bash(rm -f -r:*)",
      "Bash(sudo rm:*)",
      "Edit(**/dist/**)",
      "Edit(**/build/**)",
      "Edit(**/worker-configuration.d.ts)",
      "Edit(**/drizzle/migrations/**)",
      "Edit(**/pnpm-lock.yaml)",
      "Edit(pnpm-lock.yaml)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/.turbo/**)",
      "Read(**/.wrangler/**)",
      "Read(**/coverage/**)",
      "Read(**/*.tsbuildinfo)",
      "Read(**/*.map)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.local)",
      "Read(**/.dev.vars.staging)",
      "Read(**/.dev.vars.production)",
      "Read(**/.prod.vars)",
      "Read(**/.prod.vars.*)",
      "Read(**/.staging.vars)",
      "Read(**/.staging.vars.*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/credentials.json)",
      "Read(**/secrets.json)",
      "Edit(**/.dev.vars)",
      "Edit(**/.dev.vars.local)",
      "Edit(**/.dev.vars.staging)",
      "Edit(**/.dev.vars.production)",
      "Edit(**/.prod.vars)",
      "Edit(**/.prod.vars.*)",
      "Edit(**/.staging.vars)",
      "Edit(**/.staging.vars.*)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Edit(**/.env.production)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/id_rsa)",
      "Edit(**/id_ed25519)",
      "Edit(**/credentials.json)",
      "Edit(**/secrets.json)",
      "Agent(statusline-setup)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(pnpm deploy:*)",
      "Bash(pnpm run deploy:*)",
      "Bash(pnpm turbo run deploy:*)",
      "Bash(wrangler deploy:*)",
      "Bash(wrangler delete:*)",
      "Bash(wrangler secret:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)"
    ],
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/git/guard-secret-commit.sh"
            ],
            "timeout": 10,
            "statusMessage": "Checking git command for secret paths"
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/git/guard-destructive-git.sh"
            ],
            "timeout": 10,
            "statusMessage": "Checking git command for destructive operations"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/security/guard-secret-content.sh"
            ],
            "timeout": 10,
            "statusMessage": "Scanning content for credentials"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/quality/check-changed.sh"
            ],
            "timeout": 30,
            "statusMessage": "Formatting and linting the edited file"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/logging/instructions-loaded.sh"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "gh *"
    ],
    "network": {
      "allowedDomains": [
        "registry.npmjs.org"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.config/.wrangler",
          "mode": "deny"
        },
        {
          "path": "~/.wrangler",
          "mode": "deny"
        },
        {
          "path": "~/Library/Preferences/.wrangler",
          "mode": "deny"
        }
      ]
    }
  },
  "autoMemoryEnabled": true,
  "enabledMcpjsonServers": [
    "cloudflare-docs",
    "context7"
  ],
  "enableAllProjectMcpServers": false,
  "worktree": {
    "sparsePaths": [
      ".agents",
      ".changeset",
      ".claude",
      ".cursor",
      ".github",
      ".vite-hooks",
      ".vscode",
      ".cursorignore",
      ".cursorindexingignore",
      ".gitignore",
      ".mcp.json",
      ".nvmrc",
      ".oxfmtrc.json",
      ".oxlintrc.json",
      ".syncpackrc.json",
      ".worktreeinclude",
      "AGENTS.md",
      "CLAUDE.md",
      "LICENSE",
      "README.md",
      "hooks",
      "apps",
      "packages",
      "knip.jsonc",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "skills-lock.json",
      "turbo.json",
      "vite.config.ts"
    ],
    "baseRef": "fresh"
  },
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "20",
    "TURBO_TELEMETRY_DISABLED": "1",
    "WRANGLER_SEND_METRICS": "false",
    "REACT_DOCTOR_NO_TELEMETRY": "1"
  }
}
