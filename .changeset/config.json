{
  "$schema": "https://unpkg.com/@changesets/config@4.0.1/schema.json",
  "changelog": "@changesets/changelog-github",
  "baseBranch": "main",
  "changedFilePatterns": [
    "**",
    "!*.md",
    "!tests/**",
    "!vitest.config.*",
    "!vitest.setup.*",
    "!turbo.json"
  ],
  "privatePackages": {
    "version": true,
    "tag": false
  },
  "fixed": [["*"]],
  "ignore": ["@repo/vitest-config"]
}
