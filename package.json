{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "pnpm + Turborepo monorepo starter with Cloudflare Workers, Hono HTTP gateway, and React (Vite) frontend.",
  "keywords": [
    "cloudflare-workers",
    "hono",
    "monorepo",
    "pnpm",
    "react",
    "turborepo",
    "vite",
    "zod"
  ],
  "scripts": {
    "boundaries": "turbo boundaries",
    "build": "turbo run build",
    "build:ci": "cross-env VITE_API_BASE_URL=https://worker-api-ci.monorepo-template.workers.dev turbo run build",
    "cd:inventory": "node scripts/cd/inventory.mjs",
    "cd:select": "node scripts/cd/select-affected-deployables.mjs",
    "cd:smoke:front-app": "node scripts/cd/smoke-front-app.mjs",
    "cd:smoke:worker-api": "node scripts/cd/smoke-worker-api.mjs",
    "cd:upload": "node scripts/cd/upload-affected.mjs",
    "check": "pnpm run lint:check && pnpm run format:check",
    "check-types": "turbo run check-types",
    "ci": "pnpm run boundaries && pnpm run lint:check && pnpm run format:check && turbo run check-types && pnpm run types:check && turbo run test && pnpm run build:ci",
    "deploy": "turbo run deploy",
    "dev": "turbo run dev",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint:agent": "cross-env SYNCKIT_TIMEOUT=120000 oxlint --no-error-on-unmatched-pattern --format=agent .",
    "lint:check": "cross-env SYNCKIT_TIMEOUT=120000 oxlint --no-error-on-unmatched-pattern .",
    "lint:fix": "cross-env SYNCKIT_TIMEOUT=120000 oxlint --no-error-on-unmatched-pattern --fix .",
    "login": "wrangler login",
    "prepare": "husky",
    "preview": "turbo run preview --filter=front-app",
    "promote": "turbo run promote --filter=worker-api --filter=front-app",
    "skills-update": "bash .agents/skills/skills-update/scripts/update-locked-skills.sh",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "types": "turbo run types --filter='./apps/*'",
    "types:check": "turbo run types:check --filter='./apps/*'",
    "update": "pnpm update --recursive --latest",
    "upload": "turbo run upload --filter=worker-api --filter=front-app"
  },
  "devDependencies": {
    "cross-env": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "git-format-staged": "catalog:",
    "husky": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24 <25",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "monorepo": {
    "kind": "workspace",
    "role": "root",
    "agentGuide": "AGENTS.md"
  }
}
