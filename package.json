{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "pnpm + Turborepo monorepo starter with Cloudflare Workers, Hono HTTP gateway, and React (Vite) frontend.",
  "keywords": [
    "cloudflare-workers",
    "hono",
    "monorepo",
    "pnpm",
    "react",
    "turborepo",
    "vite",
    "zod"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm run lint:check && pnpm run format:check",
    "check-types": "turbo run check-types",
    "check-types:solution": "tsc -b",
    "ci": "pnpm run lint:check && pnpm run format:check && turbo run check-types",
    "dev": "turbo run dev",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint:agent": "oxlint --no-error-on-unmatched-pattern --format=agent .",
    "lint:check": "oxlint --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --no-error-on-unmatched-pattern --fix .",
    "prepare": "husky",
    "types": "turbo run types --filter='./apps/*'",
    "update": "pnpm update --recursive --latest"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.1.2",
    "cloudflare": "^7.0.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "git-format-staged": "^4.0.2",
    "husky": "^9.1.7",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "^2.10.8",
    "typescript": "catalog:",
    "wrangler": "^4.119.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "monorepo": {
    "kind": "workspace",
    "role": "root",
    "agentGuide": "AGENTS.md"
  }
}
