{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "pnpm + Turborepo monorepo starter with Cloudflare Workers, Hono HTTP gateway, and React (Vite) frontend.",
  "keywords": [
    "cloudflare-workers",
    "hono",
    "monorepo",
    "pnpm",
    "react",
    "turborepo",
    "vite",
    "zod"
  ],
  "scripts": {
    "audit": "pnpm audit --audit-level=high",
    "boundaries": "turbo boundaries",
    "build": "turbo run build",
    "check": "pnpm run lint:check && pnpm run format:check",
    "check-types": "turbo run check-types",
    "ci": "pnpm run boundaries && pnpm run lint:check && pnpm run format:check && pnpm run types:check && cross-env VITE_API_BASE_URL=https://worker-api-ci.monorepo-template.workers.dev turbo run check-types test build && pnpm run audit",
    "deploy": "turbo run deploy",
    "dev": "turbo run dev",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint:agent": "cross-env SYNCKIT_TIMEOUT=120000 oxlint --no-error-on-unmatched-pattern --format=agent .",
    "lint:check": "cross-env SYNCKIT_TIMEOUT=120000 oxlint --no-error-on-unmatched-pattern .",
    "lint:fix": "cross-env SYNCKIT_TIMEOUT=120000 oxlint --no-error-on-unmatched-pattern --fix .",
    "login": "wrangler login",
    "prepare": "vp config --no-agent",
    "preview": "turbo run preview --filter=front-app",
    "promote": "turbo run promote --filter=worker-api --filter=front-app",
    "skills-update": "bash .agents/skills/skills-update/scripts/update-locked-skills.sh",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "types": "turbo run types --filter='./apps/*'",
    "types:check": "turbo run types:check --filter='./apps/*'",
    "update": "pnpm update --recursive --latest",
    "upload": "turbo run upload --filter=worker-api --filter=front-app"
  },
  "devDependencies": {
    "cross-env": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24 <25",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "monorepo": {
    "kind": "workspace",
    "role": "root",
    "agentGuide": "AGENTS.md"
  }
}
