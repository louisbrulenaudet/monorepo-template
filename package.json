{
  "name": "monorepo",
  "description": "pnpm + Turborepo monorepo starter with Cloudflare Workers, Hono HTTP gateway, and React (Vite) frontend.",
  "version": "0.0.0",
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@vitest/ui": "catalog:",
    "cross-env": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "syncpack": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24 <25",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "keywords": [
    "cloudflare-workers",
    "hono",
    "monorepo",
    "pnpm",
    "react",
    "turborepo",
    "vite",
    "zod"
  ],
  "monorepo": {
    "kind": "workspace",
    "role": "root",
    "agentGuide": "AGENTS.md"
  },
  "packageManager": "pnpm@12.1.0+sha512.d9b8276d97f6ec86e49815877f91ee9f63cee61f2063b304e43b6dab8fa07ce8a9afd46d2facd39f921e6a9d06b3c75a81349c7b888c2d22886bae0229901037",
  "private": true,
  "scripts": {
    "audit": "pnpm audit --audit-level=high",
    "boundaries": "turbo boundaries",
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "pnpm run lint:check && pnpm run format:check",
    "check-types": "turbo run check-types",
    "ci": "pnpm run boundaries && pnpm run deps:check && pnpm run deps:format --check && pnpm run knip && pnpm run knip:production && pnpm run lint:check && pnpm run format:check && pnpm run types:check && cross-env VITE_API_BASE_URL=https://worker-api-ci.monorepo-template.workers.dev turbo run check-types test build && pnpm run audit",
    "deploy": "turbo run deploy",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "deps:format": "syncpack format",
    "dev": "turbo run dev",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "knip": "knip",
    "knip:agent": "knip --reporter symbols",
    "knip:production": "knip --production --strict",
    "lint:agent": "cross-env SYNCKIT_TIMEOUT=120000 oxlint --no-error-on-unmatched-pattern --format=agent .",
    "lint:check": "cross-env SYNCKIT_TIMEOUT=120000 oxlint --no-error-on-unmatched-pattern .",
    "lint:ci": "cross-env SYNCKIT_TIMEOUT=120000 oxlint --no-error-on-unmatched-pattern --format=github .",
    "lint:fix": "cross-env SYNCKIT_TIMEOUT=120000 oxlint --no-error-on-unmatched-pattern --fix .",
    "login": "wrangler login",
    "prepare": "vp config --no-agent",
    "preview": "turbo run preview --filter=front-app",
    "promote": "turbo run promote --filter=worker-api --filter=front-app",
    "release:status": "changeset status --verbose",
    "skills-update": "bash .agents/skills/skills-update/scripts/update-locked-skills.sh",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "types": "turbo run types --filter='./apps/*'",
    "types:check": "turbo run types:check --filter='./apps/*'",
    "update": "pnpm update --recursive --latest",
    "upload": "turbo run upload --filter=worker-api --filter=front-app"
  }
}
